{%- if c and mode == "recipes" -%}
<div class="layout layout--col layout--top">
  <div class="grid grid--cols-2 gap--medium w--full">
    {%- for r in recipes limit: 6 -%}
    <div class="{% if forloop.index > 4 %}hidden lg:portrait:flex {% else %}flex {% endif %}flex--col flex--left gap--xsmall">
      <span class="label label--small lg:label--base{% if r.focus %} label--underline{% endif %} 1bit:text--black">{{ r.name | truncate: 18 }}</span>
      <div class="flex flex--row flex--between flex--bottom w--full">
        <span class="value value--small lg:value--large value--tnums 1bit:text--black">{{ r.s_s }}</span>
        <span class="label label--small lg:label--base value--tnums 1bit:text--black">{{ r.d7_s }}</span>
      </div>
      <svg class="w--full h--2 lg:h--3" viewBox="0 0 100 10" preserveAspectRatio="none"><rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="{{ r.pct }}" height="10" fill="#000"/></svg>
    </div>
    {%- endfor -%}
  </div>
</div>
{%- elsif c and mode == "all" -%}
{%- assign tx_local = "label label--small lg:label--base 1bit:text--black" -%}
{%- assign cap = 12 -%}{%- assign ncols = 2 -%}
{%- if n_all < cap -%}{%- assign shown = n_all -%}{%- else -%}{%- assign shown = cap -%}{%- endif -%}
{%- if shown < ncols -%}{%- assign ncols = shown -%}{%- endif -%}
{%- assign ncols_og = ncols -%}{%- assign ncols_x = ncols -%}
{%- if shown <= 12 and shown >= 2 -%}{%- assign ncols_x = 2 -%}{%- endif -%}
<div class="layout layout--col layout--top gap--small lg:gap--medium">
  
  {%- for pass in (1..2) -%}
  {%- if pass == 1 -%}{%- assign ncols = ncols_og -%}{%- assign row_txt = tx_local -%}{%- assign trunc = 13 -%}{%- assign wrap = "lg:hidden" -%}{%- assign col_gap = "gap--xsmall lg:gap--small" -%}
  {%- else -%}{%- assign ncols = ncols_x -%}{%- assign row_txt = "label lg:label--large lg:portrait:label--base value--tnums" -%}{%- assign trunc = 12 -%}{%- assign wrap = "hidden lg:grid" -%}{%- assign col_gap = "gap--medium" -%}{%- endif -%}
  {%- assign per = shown | plus: ncols | minus: 1 | divided_by: ncols | floor -%}
  <div class="grid grid--cols-{{ ncols }} gap--large w--full {{ wrap }}">
    {%- for col in (1..ncols) -%}
    {%- assign off = col | minus: 1 | times: per -%}
    <div class="flex flex--col flex--left flex--top {{ col_gap }}">
      {%- for r in all limit: per offset: off -%}
      {%- if off < shown -%}
      <div class="flex flex--col gap--xsmall w--full">
        <div class="flex flex--row flex--between flex--center-y gap--small w--full">
          <span class="{{ row_txt }}{% if r.f %} label--underline{% endif %}">{{ forloop.index | plus: off }}. {{ r.n | truncate: trunc }}</span>
          <div class="flex flex--row gap--xsmall no-shrink"><span class="{{ row_txt }} value--tnums">{{ r.s }}</span><span class="{{ row_txt }} value--tnums">{{ r.d }}</span></div>
        </div>
        {%- if pass == 2 and r.p -%}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <svg class="w--full h--3" viewBox="0 0 100 10" preserveAspectRatio="none"><rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="{{ r.p }}" height="10" fill="#000"/></svg>
          <span class="label label--small value--tnums no-shrink">{{ r.x }}</span>
        </div>
        {%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endfor -%}
  </div>
  {%- endfor -%}
  {%- if n_all > shown -%}<span class="label label--small 1bit:text--black">+{{ n_all | minus: shown }}</span>{%- endif -%}
</div>
{%- elsif c -%}
<div class="layout layout--col layout--top gap--small">
  <div class="grid grid--cols-2 lg:portrait:grid--cols-1 gap--medium w--full">
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.connections }}</span>
      <span class="value {{ hero_sm_cls }} value--tnums">{{ c.total_s }}</span>
      <span class="label hidden lg:portrait:block">{{ c.d7_s }} · {{ t.d7 }}</span>
    </div>
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.rank }}</span>
      <span class="value {{ rank_cls }} value--tnums">{{ c.rank_s }}</span>
      <span class="label hidden lg:portrait:block">{{ c.of_s }} · {{ c.top_s }}</span>
    </div>
  </div>
  <div class="grid grid--cols-2 gap--medium w--full lg:portrait:hidden">
    <div class="flex flex--row flex--left flex--center-y gap--small">
      <span class="label label--inverted lg:label--base">{{ c.d7_s }}</span>
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.d7 }}</span>
    </div>
    <div class="flex flex--row flex--left flex--center-y gap--xsmall">
      {{ move_icon }}<span class="label label--small lg:label--base 1bit:text--black">{{ c.of_s }}</span>
    </div>
  </div>
  <div class="hidden lg:grid lg:portrait:hidden grid--cols-2 gap--medium w--full">
    <span class="label value--tnums">{{ c.d24_s }} · {{ t.d24 }} · {{ c.per_day_s }}</span>
    <span class="label">{{ c.gap_up_s | truncate: 30 }}</span>
  </div>
  <div class="h--8 lg:h--20 lg:portrait:h--24 w--full no-shrink">
    <svg class="w--full h--full" viewBox="0 0 300 100" preserveAspectRatio="none">
      <polyline points="{{ chart.line }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
    </svg>
  </div>
  <div class="hidden lg:block lg:portrait:hidden h--8 w--full no-shrink">
    <svg class="w--full h--full" viewBox="0 0 300 100" preserveAspectRatio="none"><path d="{{ chart.bars }}" fill="#000"/></svg>
  </div>
</div>
{%- else -%}
<div class="layout layout--col layout--center gap--small">
  <span class="title title--small text--center 1bit:text--black">{% if t %}{{ t.not_found }}{% else %}No recipe found with this ID{% endif %}</span>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="{{ icon_src }}">
  <span class="title">{{ app_name }}</span>
  <span class="instance">{% if c %}{{ c.name }}{% endif %}</span>
</div>
