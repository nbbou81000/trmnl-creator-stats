{%- if c and mode == "recipes" -%}
<div class="layout layout--col layout--top gap--medium">
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="title title--small 1bit:text--black">{{ t.my_recipes }}</span>
    <span class="label label--small lg:label--base value--tnums 1bit:text--black">{{ c.total_s }} · {{ c.d7_s }} {{ t.d7 }}</span>
  </div>
  <div class="flex flex--col flex--left gap--medium lg:gap--large w--full">
    {%- for r in recipes limit: 9 -%}
    <div class="{% if forloop.index > 5 %}hidden lg:flex {% else %}flex {% endif %}flex--row flex--center-y gap--medium w--full">
      <div class="flex flex--col flex--left gap--xsmall grow">
        <span class="title title--small{% if r.focus %} label--underline{% endif %} 1bit:text--black">{{ r.name | truncate: 22 }}</span>
        <div class="flex flex--row flex--center-y gap--small w--full">
          <svg class="w--full h--2 lg:h--3" viewBox="0 0 100 10" preserveAspectRatio="none"><rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="{{ r.pct }}" height="10" fill="#000"/></svg>
          <span class="label label--small value--tnums no-shrink 1bit:text--black">{{ r.next_s }}</span>
        </div>
      </div>
      <div class="w--20 lg:w--32 h--10 lg:h--14 no-shrink">
        <svg class="w--full h--full" viewBox="0 0 300 100" preserveAspectRatio="none"><polyline points="{{ r.spark | default: '0,94 300,94' }}" fill="none" stroke="#000" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg>
      </div>
      <div class="flex flex--col flex--right no-shrink">
        <span class="value value--xsmall lg:value--small value--tnums 1bit:text--black">{{ r.s_s }}</span>
        <span class="label label--small value--tnums 1bit:text--black">{{ r.d7_s }}</span>
      </div>
    </div>
    {%- endfor -%}
  </div>
</div>
{%- elsif c and mode == "all" -%}
{%- assign tx_local = "label label--small lg:label--base 1bit:text--black" -%}
{%- assign cap = 36 -%}{%- assign ncols = 2 -%}
{%- if n_all < cap -%}{%- assign shown = n_all -%}{%- else -%}{%- assign shown = cap -%}{%- endif -%}
{%- if shown < ncols -%}{%- assign ncols = shown -%}{%- endif -%}
{%- assign ncols_og = ncols -%}{%- assign ncols_x = ncols -%}
{%- if shown <= 12 and shown >= 1 -%}{%- assign ncols_x = 1 -%}{%- endif -%}
<div class="layout layout--col layout--top gap--small lg:gap--medium">
  {{ all_header }}
  {%- for pass in (1..2) -%}
  {%- if pass == 1 -%}{%- assign ncols = ncols_og -%}{%- assign row_txt = tx_local -%}{%- assign trunc = 14 -%}{%- assign wrap = "lg:hidden" -%}{%- assign col_gap = "gap--xsmall lg:gap--small" -%}
  {%- else -%}{%- assign ncols = ncols_x -%}{%- assign row_txt = "label label--xlarge value--tnums" -%}{%- assign trunc = 32 -%}{%- assign wrap = "hidden lg:grid" -%}{%- assign col_gap = "gap--medium" -%}{%- endif -%}
  {%- assign per = shown | plus: ncols | minus: 1 | divided_by: ncols | floor -%}
  <div class="grid grid--cols-{{ ncols }} gap--large w--full {{ wrap }}">
    {%- for col in (1..ncols) -%}
    {%- assign off = col | minus: 1 | times: per -%}
    <div class="flex flex--col flex--left flex--top {{ col_gap }}">
      {%- for r in all limit: per offset: off -%}
      {%- if off < shown -%}
      <div class="flex flex--col gap--xsmall w--full">
        <div class="flex flex--row flex--between flex--center-y gap--small w--full">
          <span class="{{ row_txt }}{% if r.f %} label--underline{% endif %}">{{ forloop.index | plus: off }}. {{ r.n | truncate: trunc }}</span>
          <div class="flex flex--row gap--xsmall no-shrink"><span class="{{ row_txt }} value--tnums">{{ r.s }}</span><span class="{{ row_txt }} value--tnums">{{ r.d }}</span></div>
        </div>
        {%- if pass == 2 and r.p -%}
        <div class="flex flex--row flex--center-y gap--small w--full">
          <svg class="w--full h--3" viewBox="0 0 100 10" preserveAspectRatio="none"><rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="{{ r.p }}" height="10" fill="#000"/></svg>
          <span class="label label--small value--tnums no-shrink">{{ r.x }}</span>
        </div>
        {%- endif -%}
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
    {%- endfor -%}
  </div>
  {%- endfor -%}
  {%- if n_all > shown -%}<span class="label label--small 1bit:text--black">+{{ n_all | minus: shown }}</span>{%- endif -%}
</div>
{%- elsif c -%}
<div class="layout layout--col layout--top gap--medium">
  <div class="grid grid--cols-2 gap--medium w--full">
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.connections }}</span>
      <span class="value {{ hero_sm_cls }} value--tnums">{{ c.total_s }}</span>
      <div class="flex flex--row flex--center-y gap--small">
        <span class="label label--inverted lg:label--base">{{ c.d7_s }}</span>
        <span class="label label--small lg:label--base 1bit:text--black">{{ t.d7 }}</span>
      </div>
    </div>
    <div class="flex flex--col flex--left flex--top">
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.rank }}</span>
      <span class="value {{ rank_cls }} value--tnums">{{ c.rank_s }}</span>
      <div class="flex flex--row flex--center-y gap--xsmall">
        {{ move_icon }}<span class="label label--small lg:label--base 1bit:text--black">{{ c.of_s }}</span>
      </div>
    </div>
  </div>

  <div class="flex flex--col flex--left gap--xsmall w--full">
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small lg:label--base 1bit:text--black">{{ t.chart_total }}</span>
      <span class="label label--small label--gray lg:label--base 1bit:text--black">{{ chart.max_s }}</span>
    </div>
    <div class="h--16 lg:h--28 lg:portrait:h--40 w--full no-shrink">
      <svg class="w--full h--full" viewBox="0 0 300 100" preserveAspectRatio="none">
        <path d="M0 6H300M0 94H300" stroke="#000" stroke-width="1" stroke-dasharray="2 5" vector-effect="non-scaling-stroke" fill="none"/>
        <polyline points="{{ chart.line }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
    <div class="h--5 lg:h--8 lg:portrait:h--12 w--full no-shrink">
      <svg class="w--full h--full" viewBox="0 0 300 100" preserveAspectRatio="none"><path d="{{ chart.bars }}" fill="#000"/></svg>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small label--gray 1bit:text--black">{{ chart.start_s }}</span>
      <span class="label label--small label--gray 1bit:text--black">{{ chart.end_s }}</span>
    </div>
  </div>

  <div class="divider"></div>

{%- assign og_pages = n_recipes | plus: 1 | divided_by: 2 | floor -%}{%- if og_pages < 1 -%}{%- assign og_pages = 1 -%}{%- endif -%}
{%- assign og_off = rot_h | modulo: og_pages | times: 2 -%}{%- assign og_max = n_recipes | minus: 2 -%}{%- if og_max < 0 -%}{%- assign og_max = 0 -%}{%- endif -%}{%- if og_off > og_max -%}{%- assign og_off = og_max -%}{%- endif -%}
{%- assign og_end = og_off | plus: 2 -%}{%- if og_end > n_recipes -%}{%- assign og_end = n_recipes -%}{%- endif -%}
{%- assign x_pages = n_recipes | plus: 4 | divided_by: 5 | floor -%}{%- if x_pages < 1 -%}{%- assign x_pages = 1 -%}{%- endif -%}
{%- assign x_off = rot_h | modulo: x_pages | times: 5 -%}{%- assign x_max = n_recipes | minus: 5 -%}{%- if x_max < 0 -%}{%- assign x_max = 0 -%}{%- endif -%}{%- if x_off > x_max -%}{%- assign x_off = x_max -%}{%- endif -%}
{%- assign x_end = x_off | plus: 5 -%}{%- if x_end > n_recipes -%}{%- assign x_end = n_recipes -%}{%- endif -%}
{%- assign xp_pages = n_recipes | plus: 7 | divided_by: 8 | floor -%}{%- if xp_pages < 1 -%}{%- assign xp_pages = 1 -%}{%- endif -%}
{%- assign xp_off = rot_h | modulo: xp_pages | times: 8 -%}{%- assign xp_max = n_recipes | minus: 8 -%}{%- if xp_max < 0 -%}{%- assign xp_max = 0 -%}{%- endif -%}{%- if xp_off > xp_max -%}{%- assign xp_off = xp_max -%}{%- endif -%}
{%- assign xp_end = xp_off | plus: 8 -%}{%- if xp_end > n_recipes -%}{%- assign xp_end = n_recipes -%}{%- endif -%}
  <div class="flex flex--col flex--left gap--small lg:gap--medium w--full">
    {%- for r in recipes limit: 30 -%}
    {%- assign k = forloop.index0 -%}
    {%- if k >= og_off and k < og_end -%}{%- assign v_og = "flex" -%}{%- else -%}{%- assign v_og = "hidden" -%}{%- endif -%}
    {%- if k >= x_off and k < x_end -%}{%- assign v_x = "lg:flex" -%}{%- else -%}{%- assign v_x = "lg:hidden" -%}{%- endif -%}
    {%- if k >= xp_off and k < xp_end -%}{%- assign v_xp = "lg:portrait:flex" -%}{%- else -%}{%- assign v_xp = "lg:portrait:hidden" -%}{%- endif -%}
    {%- if v_og == "flex" or v_x == "lg:flex" or v_xp == "lg:portrait:flex" -%}
    <div class="{{ v_og }} {{ v_x }} {{ v_xp }} flex--col flex--left gap--xsmall w--full">
      <div class="flex flex--row flex--between w--full">
        <span class="title title--small{% if r.focus %} label--underline{% endif %} 1bit:text--black">{{ r.name | truncate: 26 }}</span>
        <span class="label label--small value--tnums 1bit:text--black">{{ r.s_s }}</span>
      </div>
      <div class="flex flex--row flex--center-y gap--small w--full">
        <svg class="w--full h--2 lg:h--3" viewBox="0 0 100 10" preserveAspectRatio="none"><rect x="0.5" y="0.5" width="99" height="9" fill="none" stroke="#000" stroke-width="1" vector-effect="non-scaling-stroke"/><rect x="0" y="0" width="{{ r.pct }}" height="10" fill="#000"/></svg>
        <span class="label label--small label--gray value--tnums no-shrink 1bit:text--black">{{ r.d7_s }} · {{ r.next_s }}</span>
      </div>
    </div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- else -%}
<div class="layout layout--col layout--center gap--small">
  <span class="title title--small text--center 1bit:text--black">{% if t %}{{ t.not_found }}{% else %}No recipe found with this ID{% endif %}</span>
  <span class="label label--small text--center 1bit:text--black">trmnl.com/recipes/12345</span>
</div>
{%- endif -%}

<div class="title_bar">
  <img class="image" src="{{ icon_src }}">
  <span class="title">{{ app_name }}</span>
  <span class="instance">{% if c %}{{ c.name }}{% endif %}</span>
</div>
